[Unit]
Description=Taiko Sync Dispatcher
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sigaer/taiko
Environment=TAIKO_RUNTIME_ROOT=/home/sigaer/taiko
EnvironmentFile=/etc/taiko-runtime.env
ExecStart=/opt/taiko-bot/current/bin/python -I -m taiko_bot.services.sync_dispatch_server
Restart=always
RestartSec=3
User=root
Group=root

[Install]
WantedBy=multi-user.target
