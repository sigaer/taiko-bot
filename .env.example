DRIVER=~fastapi+~httpx+~websockets
HOST=0.0.0.0
PORT=37564
TAIKO_SONG_PROFILE=client

# Viewer 公共数据与 Bot API。
TAIKO_VIEWER_BASE_URL=https://viewer.sakura-bot.cn
TAIKO_PUBLIC_DATA_BASE_URL=https://viewer.sakura-bot.cn/api/taiko
# 已获批 Developer token：全部用户成绩读取与 Bot 绑定、同步接口，受每日额度限制。
TAIKO_VIEWER_DEVELOPER_TOKEN=

# 可选：仅手动成绩账号的创建、认领和修改需要维护者提供此令牌。
TAIKO_BOT_SERVICE_TOKEN=

# 可选：QQ 官方机器人。
QQ_IS_SANDBOX=false
# QQ_BOTS=[{"id":"your_app_id","token":"your_token","secret":"your_secret","use_websocket":true,"intent":{"c2c_group_at_messages":true,"at_messages":false}}]
# QQ 官方图片默认使用 Markdown；需要本机缓存目录的公开 HTTPS 地址。
# QQ_MARKDOWN_IMAGE_BASE_URL=https://your-domain/qqbot-cache/taiko
# 源文件默认30分钟后清理；URL持有者可访问，CDN/客户端缓存可能延长可见时间。
# QQ_MARKDOWN_IMAGE_TTL_SECONDS=1800
# QQ_MARKDOWN_IMAGE_CLEANUP_INTERVAL_SECONDS=300

# 官方 QQ 中心端「是什么歌」使用 Viewer 现有公开谱面 URL；默认关闭。
# 启用前验证 Viewer 谱面与本机一致、QQ 域名可用；无需发布额外资源。
TAIKO_QQ_FIXED_FUMEN_URL=0

# 可选：仅允许特定群使用 Bot，JSON 示例：{"Bot账号":["群号"]}。
# BOT_GROUP_WHITELIST_PATH=./storage/config/bot_group_whitelist.json
